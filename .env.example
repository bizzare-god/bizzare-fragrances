# Database Connection (PostgreSQL - Neon / Supabase / Local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Production Domain & App URL
NEXT_PUBLIC_APP_URL="https://bizzarefragrances.shop"

# Auth Secret (Minimum 32 random characters for HMAC session signing)
AUTH_SECRET="replace-with-a-random-string-of-at-least-32-characters"

# Payment Gateway (Paystack)
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"

# Cloud Image Storage (Vercel Blob - required in production)
BLOB_READ_WRITE_TOKEN=""

# Email Service (Resend)
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="Bizzare Fragrances <onboarding@resend.dev>"
SUPPORT_FORWARD_EMAIL="concierge@bizzarefragrances.shop"
